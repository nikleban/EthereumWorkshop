# Copy to server/.env for local dev. In production set these in Dokploy.
# None of these use the VITE_ prefix, so they never reach the browser.

PORT=3000

ALCHEMY_MAINNET_URL=https://eth-mainnet.g.alchemy.com/v2/<key>
ALCHEMY_SEPOLIA_URL=https://eth-sepolia.g.alchemy.com/v2/<key>

FAUCET_PRIVATE_KEY=
# 0.01 ETH
FAUCET_AMOUNT_WEI=10000000000000000

# Where the built frontend lives (Dockerfile can override)
STATIC_DIR=../client/frontend/dist
